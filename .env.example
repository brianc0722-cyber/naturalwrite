# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Postgres connection string. Also used by drizzle-kit (see drizzle.config.ts).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# Optional — password protection
# ---------------------------------------------------------------------------
# Leave BLANK to run fully open (the default, and how the app has always
# behaved). Set any non-empty value to require a password before the app or
# its API can be used.
#
# This is a SINGLE SHARED SECRET, not user accounts. It answers "is this the
# owner of this deployment?" and nothing more — there is no per-user data
# separation and no audit trail, because the data model (one style profile,
# one sample library, one scan history) is single-tenant by design.
#
# What it closes: without it, anyone who finds your URL can read every sample
# and scan you've stored, and can delete any record whose id they know.
# (Record ids are random uuids, so they can no longer be guessed in sequence.)
#
# Changing this value immediately signs out every existing session.
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional — generative-AI "second opinion" on scans
# ---------------------------------------------------------------------------
# PRIVACY: when OPENAI_API_KEY is set, up to ~14 KB of the text being scanned
# is sent to the configured endpoint. Leave blank to keep every scan local;
# the app degrades gracefully to its own heuristics.
OPENAI_API_KEY=

# Override to use a compatible provider or proxy. Defaults to the OpenAI API.
#
# This URL receives OPENAI_API_KEY in an Authorization header, so it must be
# https and must match a recognised provider host (OpenAI, OpenRouter, Groq,
# Mistral, Together, Anthropic, Google). http://localhost is allowed for
# locally hosted models.
OPENAI_BASE_URL=

# Set to 1 to allow any https OPENAI_BASE_URL, for a self-hosted endpoint on
# your own domain. Only do this if you control the destination.
OPENAI_BASE_URL_ALLOW_ANY=

# Model used for the second opinion.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Optional — upload size limit
# ---------------------------------------------------------------------------
# Largest document the scanner will accept, in megabytes. Default 4.
#
# Vercel rejects any request body over 4.5 MB at the platform level, before
# application code runs, returning an opaque 413 the app cannot dress up. The
# default sits just under that ceiling. Raise it ONLY when self-hosting
# (VPS, Docker, Render, Fly), and set BOTH variables to the same number --
# the server enforces the first, the browser displays and pre-checks the
# second. Setting only one leaves the UI and API disagreeing.
MAX_UPLOAD_MB=
NEXT_PUBLIC_MAX_UPLOAD_MB=

# ---------------------------------------------------------------------------
# Optional — operations
# ---------------------------------------------------------------------------
# Set to 1 when schema migrations are applied as a deploy step
# (npm run db:migrate) and the app role should not hold DDL privileges.
SKIP_DB_BOOTSTRAP=
